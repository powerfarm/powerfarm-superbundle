{
  "$id": "pf.contract.capability-learning.v1",
  "version": 1,
  "status": "permanent",
  "name": "Capability Learning and Sedimentation",
  "reconciler_ref": "pf.reconciler.sedimentation",
  "purpose": "Evidence-governed succession of digital implementations beneath a durable capability without changing capability semantics, authority, work-class scope, or evidence obligations.",
  "scope": {
    "identity": "CapabilityRef + capability revision + WorkClassRef",
    "resource_hint": "CapabilityLearningScopeRef",
    "one_active_occupancy": true,
    "occupancy_is_replaceable": true
  },
  "substrates": [
    "inference",
    "configuration",
    "fixed"
  ],
  "substrate_meaning": {
    "inference": "Meaning is reconstructed by model inference on each execution.",
    "configuration": "A reprogrammable digital structure performs stable portions and routes residual uncertainty to an admitted fallback.",
    "fixed": "A deterministic digital artifact performs its admitted input domain; semantic change requires a new artifact or capability revision."
  },
  "transition_directions": [
    "harden",
    "soften"
  ],
  "ports": {
    "registry": {
      "contract_version": "powerfarm.registry.capability-learning.v1",
      "methods": [
        "resolveCapabilityLearningScope",
        "findCapabilityImplementationCandidate"
      ]
    },
    "evidence": {
      "contract_version": "powerfarm.evidence.capability-learning.v1",
      "methods": [
        "profileCapabilityWorkClass",
        "assessCapabilityImplementation",
        "recordCapabilityLearningEvidence"
      ]
    },
    "imagineering": {
      "contract_version": "powerfarm.imagineering.capability-construction.v1",
      "methods": [
        "ensureCapabilityConstruction",
        "ensureCapabilityEvaluation"
      ]
    },
    "process": {
      "contract_version": "powerfarm.process.capability-succession.v1",
      "methods": [
        "ensureCapabilityTransitionProposal"
      ]
    },
    "reconciler": {
      "contract_version": "powerfarm.sedimentation.reconciler.v1",
      "methods": [
        "reconcile"
      ]
    },
    "heartime_state": {
      "contract_version": "powerfarm.heartime.state.v1",
      "methods": [
        "nextWake",
        "prepareCycle",
        "finishCycle",
        "deferFailure"
      ]
    },
    "heartime_control": {
      "contract_version": "powerfarm.heartime.control.v1",
      "methods": [
